# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_auth

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development

# Pricing
# Default markup percent applied when a supplier has no markupPercent set
DEFAULT_MARKUP_PERCENT=20

# Rossko supplier (SOAP API credentials)
ROSSKO_API_URL=https://api.rossko.ru
ROSSKO_KEY1=your-rossko-key1
ROSSKO_KEY2=your-rossko-key2
ROSSKO_DELIVERY_ID=your-delivery-id
ROSSKO_ADDRESS_ID=your-address-id

# Tabys supplier (REST API, X-External-Api-Key)
TABYS_API_URL=https://api.tabys.parts
TABYS_API_KEY=your-tabys-api-key
TABYS_CONTRACT_ID=your-contract-uuid
TABYS_OUTLET_ID=your-outlet-uuid
TABYS_DELIVERY_TYPE=ToOutlet

# SHATE-M supplier (REST API, Bearer token). NOTE: api.shate-m.kz requires VPN.
SHATE_API_URL=https://api.shate-m.kz
SHATE_API_KEY=your-shatem-api-key
# Alternative to API key: login/password
SHATE_LOGIN=
SHATE_PASSWORD=
SHATE_AGREEMENT_CODE=your-agreement-code
SHATE_DELIVERY_ADDRESS_CODE=your-delivery-address-code
SHATE_DELIVERY_TYPE=

# Autotrade supplier (api2.autotrade.su, MD5 auth hash, data= form transport)
AUTOTRADE_API_URL=https://api2.autotrade.su/
AUTOTRADE_LOGIN=your-autotrade-login
AUTOTRADE_PASSWORD=your-autotrade-password
# Ordering (createDocUnconfirmedOrder): contract id from getBalance (# -> _),
# payment_type with_balance|at_receive, receipt 2=pickup/3=delivery/4=under-order
AUTOTRADE_CONTRACT_ID=
AUTOTRADE_PAYMENT_TYPE=with_balance
AUTOTRADE_RECEIPT_TYPE=2

# Search
# Per-supplier timeout (ms) for the parallel multi-supplier search fan-out
SEARCH_TIMEOUT_MS=15000

# Cart
# Per-item timeout (ms) for the live price/availability re-check on GET /cart
CART_RECHECK_TIMEOUT_MS=10000

# Test frontend (one-off manual testing UI under /test). Remove with test-frontend/.
SERVE_TEST_FRONTEND=false
